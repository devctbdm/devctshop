# Devct Shop — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (Neon / PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string for Drizzle ORM (Neon console → Connect → PostgreSQL, pick
# the pooled or direct connection string). The password is part of the URL and
# must be percent-encoded if it contains special characters.
# Format: postgresql://USER:PASSWORD@<host>-pooler.<region>.aws.neon.tech/neondb
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-project.us-east-1.aws.neon.tech/neondb

# Optional: separate read-only / pooled endpoint if you use one at runtime.
DATABASE_POOL_URL=

# ---------------------------------------------------------------------------
# Auth (NextAuth.js / Auth.js)
# ---------------------------------------------------------------------------
# Required. 32+ char random string used to sign session JWTs.
# Generate one with:  npx auth secret
AUTH_SECRET=your-super-secret-32-char-minimum-value
# Optional. Public site origin (used to build absolute URLs in emails and OAuth
# callbacks). In production set this to your real domain, e.g. https://devct.shop
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth (optional — email/password works without it)
# ---------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Devct Shop <no-reply@devct.shop>
EMAIL_ENABLED=false

# ---------------------------------------------------------------------------
# File storage (Cloudinary)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
